<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Adım sayar sensörünü kullanabilmek için (Android 10+ zorunlu) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Bildirim göstermek için (Android 13+ zorunlu) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Adım sayımını arka planda sürdüren foreground servis için -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Telefon yeniden başladığında servisi tekrar ayağa kaldırmak için -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Adım sayar sensörü olmayan cihazlarda da kurulum yapılabilsin (özellik zorunlu değil) -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EvoraSaglik">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Adım sayımını arka planda sürdüren servis -->
        <service
            android:name=".service.StepCounterService"
            android:foregroundServiceType="health"
            android:exported="false" />

        <!-- Telefon yeniden başlayınca servisi başlatır -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Gece yarısı günlük sıfırlama alıcısı -->
        <receiver
            android:name=".receiver.DailyResetReceiver"
            android:exported="false" />

        <!-- Ana ekran widget'ı -->
        <receiver
            android:name=".widget.EvoraWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.evora.saglik.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/evora_widget_info" />
        </receiver>

    </application>
</manifest>
